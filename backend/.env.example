# Kopiraj u .env i popuni. .env je u .gitignore i NIKAD se ne commita.

# ── Baza ─────────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:LOZINKA@localhost:5432/xlamp_ng?schema=public"

# ── Autentikacija ────────────────────────────────────────────────────────────
# Bilo kakav niz od najmanje 32 znaka. Nasumicni: openssl rand -hex 32
JWT_SECRET="promijeni-me-u-bilo-koji-niz-od-najmanje-32-znaka"
JWT_EXPIRES_IN="8h"

# ── ChirpStack ───────────────────────────────────────────────────────────────
# PRAZNO = aplikacija radi normalno, samo ne prima telemetriju s uredaja.
# Za lokalno isprobavanje ovo ostavi prazno.
#
# Podaci za spajanje na stvarnu mrezu poslani su e-mailom (nisu u repozitoriju
# jer daju pristup opremi u pogonu).
MQTT_BROKER_URL=""
MQTT_APPLICATION_ID=""

# Mora biti razlicit od bilo kojeg drugog klijenta na istom brokeru - broker
# izbacuje postojecu vezu kad se spoji klijent s istim ID-em.
MQTT_CLIENT_ID="xlamp-ng-dev"

# ── Sigurnosna ograda ────────────────────────────────────────────────────────
# Downlink smije ici SAMO na ove devEUI adrese (zarezom odvojeno, mala slova).
# Prazno = slanje naredbi je potpuno onemoguceno i svaki pokusaj vraca 403.
#
# Provjera vrijedi UVIJEK, i u dry-run nacinu. Dolje su tri adrese koje stvara
# `npm run db:seed`, da se slanje naredbi moze isprobati lokalno.
ALLOWED_DEVEUIS="8cf95720001e223d,8cf95720001e3845,8cf95720001e292d"

# true = naredbe se zapisuju u bazu, ali se NE salju na broker.
# Za lokalno isprobavanje ostavi "true" ili pokreni s `npm run dev:dry`.
DOWNLINK_DRY_RUN="true"

# ── Server ───────────────────────────────────────────────────────────────────
PORT=3000
CORS_ORIGIN="http://localhost:4200"
# Nakon koliko minuta sutnje se lampa smatra OFFLINE.
OFFLINE_AFTER_MINUTES=180
